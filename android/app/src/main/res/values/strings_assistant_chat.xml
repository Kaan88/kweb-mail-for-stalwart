<?xml version="1.0" encoding="utf-8"?>
<!-- The chat with the assistant. -->
<resources>
    <!-- Entry, top bar, input -->
    <string name="chat_entry">Ask the assistant</string>
    <string name="chat_title">Assistant</string>
    <string name="chat_new">New chat</string>
    <string name="chat_settings">Assistant settings</string>
    <string name="chat_input">Message</string>
    <string name="chat_send">Send</string>
    <string name="chat_stop">Stop</string>

    <!-- Empty state -->
    <string name="chat_empty_title">Ask about your mail and calendar</string>
    <string name="chat_empty_text">The assistant reads what it needs to answer and sends that to %1$s. It never sends or deletes mail.</string>
    <string name="chat_empty_text_no_host">The assistant reads what it needs to answer and sends that to the service you chose. It never sends or deletes mail.</string>

    <!-- The chat cannot be used -->
    <string name="chat_gate_off">The assistant is switched off.</string>
    <string name="chat_gate_chat_off">The chat is switched off in the assistant\'s settings.</string>
    <string name="chat_gate_not_agreed">You have not yet agreed to let the chat read your mail and calendar.</string>
    <string name="chat_open_settings">Open settings</string>
    <string name="chat_settings_failed">The assistant\'s settings could not be read.</string>

    <!-- Notices -->
    <string name="chat_busy">The assistant is busy with something else.</string>
    <string name="chat_failed">The assistant could not answer.</string>
    <string name="chat_new_failed">A new chat could not be started.</string>
    <string name="chat_stopped">Stopped. This question is not part of the conversation.</string>
    <plurals name="chat_end_steps">
        <item quantity="one">Stopped after %1$d step.</item>
        <item quantity="other">Stopped after %1$d steps.</item>
    </plurals>
    <string name="chat_end_size">Stopped: that was too much to read in one go. Ask for less at a time.</string>
    <string name="chat_tools_off">This model cannot look things up; it answers from the conversation only.</string>
    <string name="chat_restarted">That conversation was over. This is a new one: send your message again.</string>
    <string name="chat_no_answer">The assistant gave no answer.</string>


    <string name="chat_step_search">Searching mail</string>
    <string name="chat_step_list">Listing messages</string>
    <string name="chat_step_read_message">Reading a message</string>
    <string name="chat_step_read_thread">Reading a conversation</string>
    <string name="chat_step_folders">Looking at the folders</string>
    <string name="chat_step_labels">Looking at the labels</string>
    <string name="chat_step_events">Looking at the calendar</string>
    <string name="chat_step_event">Reading a calendar entry</string>
    <string name="chat_step_open">Pointing at a message</string>
    <string name="chat_step_draft">Writing a reply draft</string>
    <string name="chat_step_suggest">Preparing a suggestion</string>
    <string name="chat_step_other">Working</string>
